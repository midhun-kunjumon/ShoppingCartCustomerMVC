@{
    ViewData["Title"] = "Search Results";
}

<link rel="stylesheet" href="~/css/product.css" />

<section class="product-listing-page">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label">
                    SEARCH RESULTS
                </span>

                <h2>
                    Results for "@ViewBag.Query"
                </h2>

                <p class="text-muted">
                    Explore products matching your search.
                </p>
            </div>

        </div>


        <div id="search-products-container"
             data-search-query="@ViewBag.Query"
             data-customer-id="@ViewBag.CustomerId">

            <div class="text-center py-5"
                 id="products-loading">

                <span>
                    Loading products...
                </span>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script src="~/js/search.js"></script>

}
