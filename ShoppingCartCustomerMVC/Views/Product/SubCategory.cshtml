@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/product.css" />

<section class="product-listing-page">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label">
                    SHOP
                </span>

                <h2 id="subcategory-name">
                    Products
                </h2>

                <p class="text-muted">
                    Explore products in this subcategory.
                </p>
            </div>

        </div>


        <div id="subcategory-products-container"
             data-subcategory-id="@ViewBag.SubCategoryId"
             data-customer-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">

            <div class="text-center py-5"
                 id="products-loading">

                <span>
                    Loading products...
                </span>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script src="~/js/product.js"></script>

}