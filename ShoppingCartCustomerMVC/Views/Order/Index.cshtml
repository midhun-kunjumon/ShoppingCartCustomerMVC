@{
    ViewData["Title"] = "My Orders";
}

<link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />

<section class="order-page">
    <div class="container">

        <div class="order-header">
            <h1>My Orders</h1>
        </div>

        <div id="orders-loading" class="text-center py-4 text-muted">
            <div class="spinner-border text-primary me-2" role="status"></div>
            Loading your orders...
        </div>

        <div id="orders-empty" class="text-center py-5 bg-white rounded shadow-sm" style="display:none;">
            <div class="mb-3 display-4 text-muted">📦</div>
            <h3>You haven't placed any orders yet</h3>
            <p class="text-muted">When you place an order, it will appear here.</p>
            <a href="/" class="btn btn-primary px-4 py-2 mt-2">Start Shopping</a>
        </div>

        <div id="orders-content" data-customer-id="@ViewBag.CustomerId" style="display:none;">
            <div id="orders-list-container" class="orders-list">
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
